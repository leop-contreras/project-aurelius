events {}

http {
    resolver 127.0.0.11 valid=10s;

    upstream get_pool {
        zone get_pool 64k;
        {{ range service "get.backend" }}
        server {{ .Address }}:{{ .Port }} resolve max_fails=3 fail_timeout=30s;
        {{ else }}
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream post_pool {
        zone post_pool 64k;
        {{ range service "post.backend" }}
        server {{ .Address }}:{{ .Port }} resolve max_fails=3 fail_timeout=30s;
        {{ else }}
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream put_pool {
        zone put_pool 64k;
        {{ range service "put.backend" }}
        server {{ .Address }}:{{ .Port }} resolve max_fails=3 fail_timeout=30s;
        {{ else }}
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream api_pool {
        zone api_pool 64k;
        server api-service:8080 resolve;
    }

    server {
        listen 8000;

        proxy_connect_timeout 1s;

        # This headers replicate the mechanism we used on Golang for this work.
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
        add_header Access-Control-Expose-Headers X-Worker-ID always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        location /instance {
            proxy_pass http://api_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            return 200 "OK";
        }

        location /status {
            stub_status;
        }
    }

    server {
        listen 9000;
        http2 on;

        location /aurelius.InstanceService/GetInstance {
            grpc_pass grpc://get_pool;
        }

        location /aurelius.InstanceService/ListInstances {
            grpc_pass grpc://get_pool;
        }

        location /aurelius.InstanceService/CreateInstance {
            grpc_pass grpc://post_pool;
        }

        location /aurelius.InstanceService/UpdateStatus {
            grpc_pass grpc://put_pool;
        }

        location /aurelius.InstanceService/RenewInstance {
            grpc_pass grpc://put_pool;
        }

        location /aurelius.InstanceService/ListChallenges {
            grpc_pass grpc://get_pool;
        }
    }
}
